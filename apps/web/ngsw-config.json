{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/**", "/brand/**", "/icons/**"]
      }
    },
    {
      "name": "media",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/media/**", "/**/*.(svg|png|jpg|jpeg|webp|avif|gif)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-maestros",
      "urls": ["/api/v1/masters/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "4h",
        "timeout": "3s"
      }
    },
    {
      "name": "api-general",
      "urls": ["/api/v1/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1h",
        "timeout": "5s"
      }
    }
  ],
  "navigationRequestStrategy": "performance",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
