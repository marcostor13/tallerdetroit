# Configuración de ejecución de la API y del worker.
# Copia a `apps/api/.env` para desarrollo local. En staging y producción estas
# variables se gestionan en Coolify, NUNCA en el repositorio.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Base de datos ---
# Local: el docker-compose de dev levanta un replica set en 27017.
MONGODB_URI=mongodb://localhost:27017/dps-informes?replicaSet=rs0&directConnection=true

# --- Colas ---
REDIS_URL=redis://localhost:6379

# --- Autenticación (§20) ---
# Genera cada secreto con: openssl rand -base64 64
JWT_ACCESS_SECRET=cambiame-en-local-y-nunca-uses-este-valor-en-produccion
JWT_REFRESH_SECRET=cambiame-tambien-y-que-sea-distinto-del-anterior
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Object storage ---
# Local: MinIO del docker-compose de dev. Producción: AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_S3_BUCKET=dps-informes-dev
AWS_ACCESS_KEY_ID=dpsdev
AWS_SECRET_ACCESS_KEY=dpsdev12345
S3_SIGNED_URL_TTL=900

# --- CORS ---
CORS_ORIGINS=http://localhost:4200

# --- Correo (Mailpit en local: http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Informes Técnicos DPS <no-reply@detroitpower.pe>"

# --- Observabilidad ---
SENTRY_DSN=

# --- Worker ---
WORKER_PORT=3001
# Concurrencia baja a propósito: cada render de Chromium usa 300–600 MB (riesgo R6).
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=120000

# --- Correo saliente ---
# EMAIL_PROVIDER=gmail  -> requiere USER_EMAIL + PASSWORD_EMAIL (contraseña de aplicación)
# EMAIL_PROVIDER=smtp   -> requiere SMTP_URL
# EMAIL_PROVIDER=none   -> desactiva el envío
EMAIL_PROVIDER=smtp
USER_EMAIL=
PASSWORD_EMAIL=
