{
  "name": "dps-informes-tecnicos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma corporativa de informes técnicos — Detroit Power System Perú",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:worker dev:web",
    "dev:web": "npm run start -w @dps/web",
    "dev:api": "npm run start:dev -w @dps/api",
    "dev:worker": "npm run start:dev -w @dps/worker",
    "build": "npm run build -w @dps/shared && npm-run-all --parallel build:web build:api build:worker",
    "build:web": "npm run build -w @dps/web",
    "build:api": "npm run build -w @dps/api",
    "build:worker": "npm run build -w @dps/worker",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,scss,json,md,yml,yaml}\"",
    "typecheck": "npm-run-all --parallel typecheck:*",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p apps/worker/tsconfig.json --noEmit",
    "test": "npm-run-all --parallel test:api test:web",
    "test:web": "npm run test -w @dps/web",
    "test:api": "npm run test -w @dps/api",
    "test:e2e": "npm run test:e2e -w @dps/web",
    "docker:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.dev.yml down",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.66.0"
  },
  "lint-staged": {
    "*.{ts,html,css,scss,json,md,yml,yaml}": "prettier --write",
    "*.ts": "eslint --fix --max-warnings 0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-enum": [
        2,
        "always",
        [
          "web",
          "api",
          "worker",
          "shared",
          "infra",
          "ci",
          "docs",
          "deps"
        ]
      ]
    }
  },
  "overrides": {
    "js-yaml": "^5.2.3"
  }
}
